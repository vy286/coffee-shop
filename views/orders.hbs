<div class="container-fluid px-4 mt-4 mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="font-weight-bold m-0" style="color: #6f4e37; font-size: 1.6rem;">
            Quản lý đơn hàng
        </h2>
        <span class="badge badge-pill p-2 text-white" style="background-color: #6f4e37; font-size: 0.85rem;">
            Tổng: {{orders.length}} đơn hàng
        </span>
    </div>

    {{#if orders.length}}
        <div class="card border-0 shadow-sm rounded-lg overflow-hidden">
            <table class="table table-hover align-middle m-0 bg-white" style="table-layout: fixed; width: 100%;">
                <thead style="background-color: #fdfbf7; color: #6f4e37; border-bottom: 2px solid #ea5b0c15;">
                    <tr>
                        <th class="border-0 py-3 px-2" style="width: 12%;">Mã đơn</th>
                        <th class="border-0 py-3 px-2" style="width: 15%;">Khách hàng</th>
                        <th class="border-0 py-3 px-2" style="width: 11%;">SĐT</th>
                        <th class="border-0 py-3 px-2" style="width: 18%;">Địa chỉ</th>
                        <th class="border-0 py-3 px-2" style="width: 22%;">Sản phẩm</th>
                        <th class="border-0 py-3 px-2" style="width: 10%;">Tổng tiền</th>
                        <th class="border-0 py-3 px-2 text-center" style="width: 12%;">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each orders}}
                        <tr style="border-bottom: 1px solid #f0f0f0;">
                            <!-- MÃ ĐƠN -->
                            <td class="px-2 align-middle">
                                <span class="badge badge-light border text-monospace text-muted py-1 px-1 text-truncate d-block" style="font-size: 0.75rem;" title="#{{this._id}}">
                                    #{{this._id}}
                                </span>
                            </td>

                            <!-- KHÁCH HÀNG -->
                            <td class="px-2 align-middle">
                                <div class="font-weight-bold text-dark text-truncate" style="font-size: 0.88rem;" title="{{this.customerName}}">{{this.customerName}}</div>
                                {{#if this.userEmail}}
                                    <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;" title="{{this.userEmail}}">{{this.userEmail}}</small>
                                {{/if}}
                            </td>

                            <!-- SĐT -->
                            <td class="px-2 align-middle text-nowrap" style="font-size: 0.85rem;">
                                {{this.phone}}
                            </td>

                            <!-- ĐỊA CHỈ (CLICK XEM THÊM) -->
                            <td class="px-2 align-middle position-relative" style="cursor: pointer;" onclick="toggleExpandable(this)">
                                <div class="expandable-text expandable-truncated" style="font-size: 0.82rem; color: #555; word-wrap: break-word;">
                                    {{this.address}}
                                </div>
                            </td>

                            <!-- SẢN PHẨM (CLICK XEM THÊM & CẮT TÊN DÀI) -->
                            <td class="px-2 align-middle position-relative" style="cursor: pointer;" onclick="toggleExpandable(this)">
                                <div class="expandable-text expandable-truncated bg-light p-2 rounded" style="font-size: 0.82rem;">
                                    {{#each this.items}}
                                        <div class="d-flex justify-content-between text-dark mb-1">
                                            <span class="text-truncate mr-1" title="{{this.name}}">• {{this.name}}</span>
                                            <span class="font-weight-bold text-muted text-nowrap">x{{this.quantity}}</span>
                                        </div>
                                    {{#unless @last}}<hr class="my-1 border-muted">{{/unless}}
                                    {{/each}}
                                </div>
                            </td>

                            <!-- TỔNG TIỀN -->
                            <td class="px-2 align-middle font-weight-bold" style="color: #6f4e37; font-size: 0.88rem;">
                                {{formatPrice this.total}}đ
                            </td>

                            <!-- TRẠNG THÁI -->
                            <td class="px-2 align-middle text-center">
                                <form action="/orders/{{this._id}}/status" method="POST" class="d-flex flex-column align-items-center">
                                    <select 
                                        name="status" 
                                        class="form-control form-control-sm rounded border-muted mb-1 px-1"
                                        style="border-color: #d7ccc8; font-size: 0.78rem; height: 28px;"
                                    >
                                        <option value="Chờ xử lý" {{#eq this.status "Chờ xử lý"}}selected{{/eq}}>Chờ xử lý</option>
                                        <option value="Đang giao" {{#eq this.status "Đang giao"}}selected{{/eq}}>Đang giao</option>
                                        <option value="Đã giao" {{#eq this.status "Đã giao"}}selected{{/eq}}>Đã giao</option>
                                        <option value="Đã hủy" {{#eq this.status "Đã hủy"}}selected{{/eq}}>Đã hủy</option>
                                    </select>
                                    <button 
                                        type="submit" 
                                        class="btn btn-sm rounded text-white px-2 py-0 font-weight-bold w-100"
                                        style="background-color: #6f4e37; border: none; font-size: 0.75rem; height: 24px;"
                                    >
                                        Lưu
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{else}}
        <div class="text-center py-5 bg-white rounded-lg shadow-sm">
            <div style="font-size: 3rem;" class="mb-3">📭</div>
            <h5 class="text-muted">Chưa có đơn hàng nào được ghi nhận.</h5>
        </div>
    {{/if}}
</div>

<style>
    /* Giới hạn số dòng hiển thị */
    .expandable-truncated {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .expandable-full {
        display: block !important;
        -webkit-line-clamp: initial !important;
    }

    /* Đổi màu nền nhẹ khi hover vào ô có thể click */
    td.position-relative:hover {
        background-color: #fdfbf7;
    }
</style>

<script>
    function toggleExpandable(element) {
        const textElement = element.querySelector('.expandable-text');
        if (textElement) {
            textElement.classList.toggle('expandable-truncated');
            textElement.classList.toggle('expandable-full');
        }
    }
</script>