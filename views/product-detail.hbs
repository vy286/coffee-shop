<div class="container my-5">

  <div class="row">

    <!-- =========================
         ẢNH SẢN PHẨM
    ========================== -->
    <div class="col-lg-6 mb-4">

      <div class="product-detail-image">
        <img
          src="{{product.image}}"
          alt="{{product.name}}"
          class="img-fluid rounded"
        />
      </div>

    </div>


    <!-- =========================
         THÔNG TIN SẢN PHẨM
    ========================== -->
    <div class="col-lg-6">

      <h1
        class="product-detail-title"
      >
        {{product.name}}
      </h1>


      <!-- Xuất xứ + mức độ rang -->
      <p class="product-detail-info">
        <strong>Xuất xứ:</strong>
        {{product.origin}}

        <span class="mx-2">|</span>

        <strong>Mức độ rang:</strong>
        {{product.roastLevel}}
      </p>


      <!-- Giá -->
      <div class="product-detail-price">
        {{formatPrice product.price}} đ
      </div>


      <hr />


      <!-- =========================
           MÔ TẢ SẢN PHẨM
      ========================== -->
      <div class="product-description">

        <h5>
          Mô tả sản phẩm
        </h5>

        {{#if product.description}}

          <p>
            {{product.description}}
          </p>

        {{else}}

          <p class="text-muted">
            Sản phẩm hiện chưa có mô tả.
          </p>

        {{/if}}

      </div>


      <!-- =========================
           SỐ LƯỢNG + THÊM GIỎ
      ========================== -->
      <form
        action="/cart/add/{{product._id}}"
        method="POST"
        class="product-detail-actions"
      >

        <label
          for="quantity"
          class="quantity-label"
        >
          Số lượng:
        </label>

        <input
          type="number"
          name="quantity"
          id="quantity"
          value="1"
          min="1"
          class="form-control quantity-input"
        />


        <button
          type="submit"
          class="detail-cart-btn"
          title="Thêm vào giỏ hàng"
        >
          <ion-icon name="cart-outline"></ion-icon>
          <span>Thêm vào giỏ</span>
        </button>

      </form>


      <!-- Quay lại -->
      <a
        href="/products"
        class="btn btn-outline-secondary mt-3"
      >
        ← Quay lại danh sách
      </a>

    </div>

  </div>

</div>