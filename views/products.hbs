<div class="container mt-5">
  <!-- TIÊU ĐỀ -->
  <h2
    class="mb-4"
    style="color: #6f4e37;"
  >
    Sản phẩm cà phê
  </h2>
  <!-- FORM TÌM KIẾM -->
  <form method="GET" action="/products" class="row mb-4 align-items-center">
    <!-- Ô tìm kiếm theo tên -->
    <div class="col-md-5 mb-2 mb-md-0">
      <div class="input-group">
        <input
          type="text"
          name="q"
          class="form-control rounded-pill border-muted px-3 py-2"
          placeholder="Tìm theo tên sản phẩm..."
          value="{{keyword}}"
          style="border-color: #d7ccc8; font-size: 0.95rem;"
        />
      </div>
    </div>
    <!-- Chọn mức độ rang -->
    <div class="col-md-4 mb-2 mb-md-0">
      <select
        name="roastLevel"
        class="form-control rounded-pill border-muted"
        style="
          border-color: #d7ccc8;
          font-size: 0.95rem;
          cursor: pointer;
          height: 42px;
          padding: 0 42px 0 18px;
          line-height: 42px;
        "
      >
        <option value="">Tất cả mức độ rang</option>
        <option value="Rang nhạt" {{#eq selectedRoast "Rang nhạt"}}selected{{/eq}}>Rang nhạt</option>
        <option value="Rang vừa" {{#eq selectedRoast "Rang vừa"}}selected{{/eq}}>Rang vừa</option>
        <option value="Rang đậm" {{#eq selectedRoast "Rang đậm"}}selected{{/eq}}>Rang đậm</option>
        <option value="Rang mộc" {{#eq selectedRoast "Rang mộc"}}selected{{/eq}}>Rang mộc</option>
      </select>
    </div>
    <!-- Nút Tìm kiếm -->
    <div class="col-md-3 mb-2 mb-md-0">
      <button
        type="submit"
        class="btn w-100 rounded-pill font-weight-bold text-white shadow-sm py-2"
        style="background-color: #6f4e37; border: none; transition: all 0.2s ease;"
        onmouseover="this.style.backgroundColor='#5a3e2b'"
        onmouseout="this.style.backgroundColor='#6f4e37'"
      >
        Tìm kiếm
      </button>
    </div>
  </form>
  <!-- DANH SÁCH SẢN PHẨM -->
  <div class="row">
    {{#each products}}
      <div class="col-md-4 mb-4">
        <div class="card shadow-sm border-0 h-100">
          <!-- ẢNH CLICK ĐỂ XEM CHI TIẾT -->
          <a
            href="/products/{{this.slug}}"
            class="text-decoration-none"
          >
            <img
              src="{{this.image}}"
              class="card-img-top"
              alt="{{this.name}}"
              style="
                height: 210px;
                object-fit: cover;
              "
            />
          </a>
          <div class="card-body">
            <!-- TÊN CLICK ĐỂ XEM CHI TIẾT -->
            <h5
              class="card-title mb-2"
              style="line-height: 1.3;"
            >
              <a
                href="/products/{{this.slug}}"
                class="text-dark text-decoration-none"
              >
                {{this.name}}
              </a>
            </h5>
            <!-- XUẤT XỨ -->
            <p
              class="card-text text-muted small mb-1"
            >
              Xuất xứ:
              {{this.origin}}
              |
              {{this.roastLevel}}
            </p>
            <!-- GIÁ -->
            <p
              class="font-weight-bold mb-3"
              style="
                color: #6f4e37;
                font-size: 18px;
              "
            >
              {{formatPrice this.price}} đ
            </p>
            <!-- ===================== -->
            <!-- ADMIN -->
            <!-- ===================== -->
            {{#if ../user.isAdmin}}
              <div>
                <a
                  href="/products/{{this._id}}/edit"
                  class="btn btn-warning btn-sm"
                >
                  Sửa
                </a>
                <form
                  action="/products/{{this._id}}?_method=DELETE"
                  method="POST"
                  class="d-inline"
                >

                  <button
                    type="submit"
                    class="btn btn-danger btn-sm"
                    onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?')"
                  >
                    Xóa
                  </button>
                </form>
              </div>
            {{else}}
            <!-- USER -->
<div class="d-flex align-items-center mt-3">

  <!-- Thêm vào giỏ -->
  <form 
    action="/cart/add/{{this._id}}" 
    method="POST" 
    class="mr-2"
  >
    <button 
      type="submit" 
      class="btn btn-cart" 
      title="Thêm vào giỏ hàng"
    >
      <ion-icon name="cart-outline"></ion-icon>
    </button>
  </form>

  <!-- Mua ngay -->
  <form 
    action="/cart/add/{{this._id}}?buyNow=true" 
    method="POST"
  >
    <button 
      type="submit" 
      class="btn text-white rounded-pill px-4"
      style="
        background-color: #6f4e37;
        border: none;
        font-weight: 600;
      "
    >
      Mua ngay
    </button>
  </form>

</div>
          {{/if}}
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>