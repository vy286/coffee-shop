<div class="mt-4">
  <h2 class="mb-4" style="color: #6f4e37;">Sản phẩm cà phê</h2>

  <div class="row">
    {{#each products}}
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <img
            src="{{this.image}}"
            class="card-img-top"
            alt="{{this.name}}"
            style="height: 200px; object-fit: cover;"
          />
          <div class="card-body">
            <h5 class="card-title">{{this.name}}</h5>
            <p class="card-text text-muted small">Xuất xứ:
              {{this.origin}}
              |
              {{this.roastLevel}}</p>
            <p class="card-text">{{this.description}}</p>
            <p class="font-weight-bold" style="color: #6f4e37;">{{this.price}}
              đ</p>
            <a href="/products/{{this.slug}}" class="btn btn-primary btn-sm">Xem
              chi tiết</a>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>