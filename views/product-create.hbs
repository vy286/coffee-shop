<div class="mt-4">
  <h2 class="mb-4" style="color: #6f4e37;">Thêm sản phẩm mới</h2>

  <form method="POST" action="/products/store" enctype="multipart/form-data">
    <div class="form-group">
      <label for="name">Tên sản phẩm</label>
      <input
        type="text"
        class="form-control"
        id="name"
        name="name"
        placeholder="VD: Cà phê Culi rang mộc"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Mô tả</label>
      <textarea
        class="form-control"
        id="description"
        name="description"
        rows="3"
        placeholder="Mô tả hương vị, đặc điểm sản phẩm..."
      ></textarea>
    </div>

    <div class="form-group">
      <label for="image">Hình ảnh sản phẩm</label>
      <input
        type="file"
        class="form-control-file"
        id="image"
        name="image"
        accept="image/*"
      />
    </div>

    <div class="form-row">
      <div class="form-group col-md-4">
        <label for="price">Giá (đ)</label>
        <input
          type="number"
          class="form-control"
          id="price"
          name="price"
          placeholder="150000"
        />
      </div>
      <div class="form-group col-md-4">
        <label for="origin">Xuất xứ</label>
        <input
          type="text"
          class="form-control"
          id="origin"
          name="origin"
          placeholder="VD: Đắk Lắk, Việt Nam"
        />
      </div>
      <div class="form-group col-md-4">
        <label for="roastLevel">Mức độ rang</label>
        <select class="form-control" id="roastLevel" name="roastLevel">
          <option value="Rang nhạt">Rang nhạt</option>
          <option value="Rang vừa">Rang vừa</option>
          <option value="Rang đậm">Rang đậm</option>
          <option value="Rang mộc">Rang mộc</option>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="slug">Slug (URL thân thiện, không dấu, không khoảng trắng)</label>
      <input
        type="text"
        class="form-control"
        id="slug"
        name="slug"
        placeholder="VD: culi-rang-moc"
        required
      />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Đăng sản phẩm</button>
  </form>
</div>