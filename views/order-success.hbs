<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card border-0 shadow-lg rounded-lg p-4 p-md-5 text-center" style="background-color: #ffffff;">
        
        <!-- Icon thành công -->
        <div class="mb-3">
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background-color: #eef7ee;">
            <span style="font-size: 40px; color: #28a745;">✓</span>
          </div>
        </div>

        <!-- Tiêu đề & Lời cảm ơn -->
        <h2 class="font-weight-bold mb-2" style="color: #6f4e37;">Đặt hàng thành công!</h2>
        <p class="lead text-muted mb-4" style="font-size: 1.05rem;">
          Cảm ơn <strong>{{order.customerName}}</strong> đã tin tưởng và đặt hàng tại <strong>Coffee Shop</strong>.
        </p>

        <!-- Khối chi tiết đơn hàng -->
        <div class="p-3 mb-4 text-left rounded" style="background-color: #fdfbf7; border: 1px dashed #d7ccc8;">
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Mã đơn hàng:</span>
            <span class="font-weight-bold" style="color: #4e342e;">{{order._id}}</span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span class="text-muted">Tổng tiền:</span>
            <strong style="color: #6f4e37; font-size: 1.1rem;">{{formatPrice order.total}} đ</strong>
          </div>
          <hr class="my-2" style="border-top: 1px solid #efebe9;" />
          <p class="mb-0 small text-muted text-center pt-1">
            Chúng tôi sẽ sớm liên hệ qua số <strong style="color: #4e342e;">{{order.phone}}</strong> để xác nhận giao hàng.
          </p>
        </div>

        <!-- Nút hành động -->
        <div>
          <a 
            href="/products" 
            class="btn btn-lg px-4 py-2 font-weight-bold text-white shadow-sm"
            style="background-color: #6f4e37; border-radius: 25px; border: none; font-size: 0.95rem;"
          >
            Tiếp tục mua sắm
          </a>
        </div>

      </div>
    </div>
  </div>
</div>