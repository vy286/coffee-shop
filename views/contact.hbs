<!-- Page Header -->
<div class="text-center py-5" style="margin-top: 1.5rem;">
  <p
    class="text-uppercase fw-bold mb-2"
    style="letter-spacing: 2px; color: #a9746e;"
  >Liên hệ</p>
  <h1 class="fw-bold" style="color: #6f4e37;">Chúng tôi luôn sẵn sàng lắng nghe
    bạn</h1>
  <p class="text-muted mx-auto" style="max-width: 600px;">
    Vui lòng để lại thông tin hoặc liên hệ trực tiếp với chúng tôi qua các kênh
    dưới đây, chúng tôi sẽ phản hồi sớm nhất.
  </p>
</div>

<!-- Contact Info Cards -->
<div class="row text-center g-4 mb-5">
  <div class="col-md-4">
    <div class="p-4 h-100 shadow-sm rounded" style="background: #fdf6ec;">
      <ion-icon
        name="location-outline"
        style="font-size: 2.5rem; color: #6f4e37;"
      ></ion-icon>
      <h5 class="mt-3 fw-bold">Địa chỉ</h5>
      <p class="mb-0 text-muted">Trường Cao đẳng Viễn Đông, Quận 12, TP. Hồ Chí
        Minh</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="p-4 h-100 shadow-sm rounded" style="background: #fdf6ec;">
      <ion-icon
        name="call-outline"
        style="font-size: 2.5rem; color: #6f4e37;"
      ></ion-icon>
      <h5 class="mt-3 fw-bold">Điện thoại</h5>
      <p class="mb-0 text-muted">03312345650</p>
    </div>
  </div>
  <div class="col-md-4">
    <div class="p-4 h-100 shadow-sm rounded" style="background: #fdf6ec;">
      <ion-icon
        name="mail-outline"
        style="font-size: 2.5rem; color: #6f4e37;"
      ></ion-icon>
      <h5 class="mt-3 fw-bold">Email</h5>
      <p class="mb-0 text-muted">admin@gmail.com</p>
    </div>
  </div>
</div>

<!-- Contact Form -->
<div class="row justify-content-center mb-5">
  <div class="col-lg-8">
    <div class="p-4 p-md-5 shadow-sm rounded" style="background: #fdf6ec;">
      <h3 class="fw-bold mb-4 text-center" style="color: #6f4e37;">Gửi tin nhắn
        cho chúng tôi</h3>

      {{#if success}}
        <div class="alert alert-success text-center mb-4" role="alert">
          {{message}}
        </div>
      {{/if}}

      <form method="POST" action="/contact">
        <div class="row g-3">
          <div class="col-md-6">
            <label for="name" class="form-label fw-bold">Họ và tên</label>
            <input
              type="text"
              class="form-control"
              id="name"
              name="name"
              placeholder="Nhập họ tên của bạn"
              required
            />
          </div>
          <div class="col-md-6">
            <label for="email" class="form-label fw-bold">Email</label>
            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              placeholder="Nhập email của bạn"
              required
            />
          </div>
          <div class="col-12">
            <label for="subject" class="form-label fw-bold">Tiêu đề</label>
            <input
              type="text"
              class="form-control"
              id="subject"
              name="subject"
              placeholder="Bạn cần hỗ trợ gì?"
              required
            />
          </div>
          <div class="col-12">
            <label for="message" class="form-label fw-bold">Nội dung</label>
            <textarea
              class="form-control"
              id="message"
              name="message"
              rows="5"
              placeholder="Nhập nội dung tin nhắn..."
              required
            ></textarea>
          </div>
          <div class="col-12 text-center">
            <button
              type="submit"
              class="btn btn-lg fw-bold px-5"
              style="background-color: #6f4e37; color: white;"
            >
              Gửi tin nhắn
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>